# Required: use a long random value. Never commit your real .env.
SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_USER=admin
ADMIN_PASSWORD=change-this-long-password-now
PORT=3000
HOST=127.0.0.1
DB_PATH=./data/roarnet.sqlite

# Provider integration stays disabled until you have an approved partner account.
PROVIDER_NAME=unconfigured
PROVIDER_API_BASE=https://api.proxies.sx
PROVIDER_API_KEY=
PROVIDER_DEVICE_ID=
PROVIDER_DEVICE_TOKEN=
PROVIDER_ENABLED=false

# Payout execution intentionally disabled. Record requests only until a real provider/payment contract exists.
PAYOUTS_ENABLED=false

# Unique random secret (32+ characters) used to encrypt provider credentials in SQLite.
APP_ENCRYPTION_KEY=replace_with_a_unique_random_secret_at_least_32_chars
