# Copy to .env on the server. Never commit real credentials.
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
SESSION_SECRET=replace_with_at_least_32_random_characters
ADMIN_USER=roarnet-admin
ADMIN_PASSWORD=replace_with_a_unique_password_at_least_16_characters
DB_PATH=./data/roarnet.sqlite

# Leave disabled until the provider gives you its official docs, approved credentials,
# confirmed API paths and permission to integrate its service in RoarNet.
PROVIDER_NAME=unconfigured
PROVIDER_API_BASE=
PROVIDER_API_KEY=
PROVIDER_DEVICE_ID=
PROVIDER_DEVICE_TOKEN=
PROVIDER_ENABLED=false

# Deliberately false until payout provider, chain, fees, compliance and transaction
# signing flow are implemented and tested. Withdrawal requests are manual-review only.
PAYOUTS_ENABLED=false

# Unique random secret (32+ characters) used to encrypt provider credentials in SQLite.
APP_ENCRYPTION_KEY=replace_with_a_unique_random_secret_at_least_32_chars
